<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>JiJianTranslate</AssemblyName>
    <RootNamespace>JiJianTranslate</RootNamespace>
    <Version>0.2.0</Version>
    <Product>极简翻译</Product>
    <Description>文字与截图，随手翻译。</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <NuGetAudit>true</NuGetAudit>
    <!-- WPF owns process DPI through the manifest; WinForms is used only for tray/screen APIs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets/*.txt" /></ItemGroup>
</Project>
